# Every variable is optional in development. The server validates them at startup and lists all problems at once.

NODE_ENV=development
PORT=3000
# Origins allowed to call the API: the dev server plus the Capacitor apps (iOS, Android dev, Android release)
CORS_ORIGINS=http://localhost:4200,capacitor://localhost,http://localhost,https://localhost,ionic://localhost
# Reverse-proxy hops to trust for the client IP (1 behind Fly.io or a single load balancer)
TRUST_PROXY=0
# Requests per minute per client IP (health checks are exempt)
RATE_LIMIT_PER_MINUTE=300
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# json | pretty (defaults to json in production)
LOG_FORMAT=

# Leave unset to use in-memory storage
DATABASE_URL=postgresql://grasp:grasp@localhost:5432/grasp

# Leave unset to use the offline scripted interviewer
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Time to first byte per Claude request, and SDK retries for 429/5xx/connection errors
ANTHROPIC_TIMEOUT_MS=60000
ANTHROPIC_MAX_RETRIES=2
# Daily Claude spend ceiling in USD (per API instance). Leave unset for no ceiling.
AI_DAILY_BUDGET_USD=
INTERVIEW_MESSAGES_PER_HOUR=120

# Serve the built web app from this directory (the Docker image sets it)
WEB_DIST_DIR=
# Shown in /api/health and attached to error reports (the Docker image sets it to the git SHA)
RELEASE=

# Signs sign-in sessions. Required in production (32+ characters); development uses a random per-process secret.
JWT_SECRET=
# Email sign-in codes are sent through Resend; without a key they are printed to the server log (development only).
RESEND_API_KEY=
MAIL_FROM=Grasp <login@grasp.dev>

# Operator token for /api/admin (pilot metrics, feedback). At least 32 characters; admin routes are disabled when unset.
ADMIN_TOKEN=

# Error reporting (optional): API errors, and web-app errors via the generated /config.json
SENTRY_DSN=
SENTRY_WEB_DSN=
SENTRY_ENVIRONMENT=
