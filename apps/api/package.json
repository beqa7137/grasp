{
  "name": "@grasp/api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run && vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "eval:interviewer": "vitest run --config ./vitest.config.live.ts",
    "eval:models": "vitest run --config ./vitest.config.models.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate:prod": "node dist/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@grasp/engine": "*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@sentry/node": "^11.0.0",
    "@vercel/functions": "^3.9.9",
    "@vercel/oidc": "^3.8.9",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.0.0",
    "@vercel/routing-utils": "^6.6.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
